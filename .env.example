# ==============================================================================
# Session Catcher — Production Environment Configuration
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_PORT=80

# --- Security & Authentication ---
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=c38e4a9b2d8f1e5a7b3c6d9e0f4a8b2c1d5e7f9a3b6c8d0e2f4a7b9c1d3e5f7a
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated or * for all)
CORS_ORIGINS=*

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sessionsecretpassword123
POSTGRES_DB=session_reserve
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:sessionsecretpassword123@postgres:5432/session_reserve

# --- Redis Cache & Celery Broker ---
REDIS_URL=redis://redis:6379/0

# --- Server & Concurrency ---
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4
MAX_WORKERS=5

# --- Storage & Directories ---
SCREENSHOTS_DIR=/app/shared/screenshots
PROFILES_DIR=/app/shared/browser-profiles
WORKER_HOST=worker
